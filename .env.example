# ---------------------------------------------------------------------------
# Mappe – Beispielkonfiguration
# Kopieren nach .env und anpassen. Alles, was hier nicht gesetzt ist, lässt
# sich später auch in der Oberfläche unter Einstellungen pflegen.
# ---------------------------------------------------------------------------

# --- Datenbank -------------------------------------------------------------
POSTGRES_USER=mappe
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=mappe
DATABASE_URL=postgresql://mappe:bitte-aendern@db:5432/mappe?schema=public

# --- Anwendung -------------------------------------------------------------
# Port, unter dem Mappe im Browser erreichbar ist.
# Im Container lauscht die Anwendung immer auf 3000; hier steht nur, worauf
# dieser Port auf dem Server abgebildet wird.
MAPPE_PORT=4300

NODE_ENV=production

# Öffentliche Adresse der Instanz.
#
# Gebraucht wird sie für genau zwei Dinge:
#   1. die Redirect-URI des Microsoft-Logins (muss in der App-Registrierung
#      exakt so eingetragen sein)
#   2. die Entscheidung, ob das Sitzungs-Cookie als „secure" gesetzt wird –
#      das passiert nur bei https://
#
# Läuft Mappe hinter einem Reverse Proxy, gehört hier die öffentliche Adresse
# mit https:// hinein, nicht localhost.
APP_URL=http://localhost:4300

# Zufälliger Wert, mit dem Sitzungen signiert werden.
# Erzeugen mit:  openssl rand -hex 32
SESSION_SECRET=bitte-durch-zufallswert-ersetzen

# Schlüssel, mit dem Zugangsdaten (Mail-Secrets, KI-API-Keys) in der Datenbank
# verschlüsselt werden. Erzeugen mit:  openssl rand -hex 32
# ACHTUNG: Geht dieser Wert verloren, müssen alle Zugangsdaten neu hinterlegt
# werden. Niemals im Betrieb ändern.
ENCRYPTION_KEY=bitte-durch-zufallswert-ersetzen

# Ablage für Dokumente, Anhänge und Original-Mails *innerhalb* des Containers.
# Hier gibt es selten einen Grund, etwas zu ändern – wo die Dateien auf dem
# Server landen, steht weiter unten.
STORAGE_DIR=/data/storage

# --- Wo die Daten auf dem Server liegen -------------------------------------
# Leer lassen: Docker verwaltet zwei benannte Volumes. Bequem, aber die Daten
# liegen dann im Docker-Abbild.
#
# Ein Pfad macht daraus ein Bind-Mount auf genau dieses Verzeichnis. Auf
# Unraid ist das die richtige Wahl – sonst erfasst das appdata-Backup die
# Daten nicht, und läuft das docker.img voll, reißt es alle anderen Container
# mit. Beispiel:
#
#   DB_DIR=/mnt/user/appdata/mappe/db
#   DOKUMENTE_DIR=/mnt/user/appdata/mappe/dokumente
#
# Die Verzeichnisse vorher anlegen – und das für DOKUMENTE_DIR dem Benutzer
# 1000 übereignen (`chown -R 1000:1000 …`), weil Mappe im Container nicht als
# root läuft. Für DB_DIR ist das nicht nötig, das erledigt Postgres selbst. Ein Wechsel im laufenden Betrieb bewegt
# die vorhandenen Daten NICHT – dazu vorher sichern und danach einspielen,
# siehe docs/betrieb.md.
DB_DIR=
DOKUMENTE_DIR=

# --- Tailscale (optional) ---------------------------------------------------
# Nur nötig, wenn Mappe mit der zusätzlichen Datei gestartet wird:
#   docker compose -f docker-compose.yml -f docker-compose.tailscale.yml up -d
#
# Mappe wird damit ein eigener Rechner im Tailnet und lässt sich dort einzeln
# freigeben – im Gegensatz zu einem Tailscale auf dem Server, über das immer
# gleich alles erreichbar ist. Der Auth-Key kommt aus der Tailscale-Verwaltung,
# der Weg steht in docs/tailscale.md.
TS_AUTHKEY=
# Name im Tailnet – zugleich der Name, der in den ACLs steht.
TS_HOSTNAME=mappe
# Wo der Anmeldezustand liegt. Leer lassen für ein Docker-Volume; auf Unraid
# gehört auch hier ein Pfad hin, sonst meldet sich der Container nach jedem
# Neustart des Abbilds neu an.
TS_STATE_DIR=
# https oder http. `https` braucht HTTPS im Tailnet (Tailscale-Verwaltung →
# DNS → HTTPS Certificates → Enable) und ist die bessere Wahl: Nur damit wird
# das Sitzungs-Cookie als `secure` gesetzt. Ohne diese Freischaltung bleibt
# der Zugang stumm – dann `http` eintragen.
TS_MODUS=https
# Nur für TS_MODUS=http: leer lassen. Die Serve-Konfiguration wird dort
# einmalig mit einem Befehl gesetzt (siehe docs/tailscale.md) – eine Datei
# würde sie bei jedem Start überschreiben.
TS_SERVE_CONFIG=
# Zusätzliche Schalter, etwa --advertise-tags=tag:mappe
TS_EXTRA_ARGS=

# --- Namensauflösung -------------------------------------------------------
# Leer lassen: Der Container nutzt Docker's eigenen Auflöser, so wie immer.
#
# Nötig wird ein Eintrag, wenn der Host seine Namensauflösung über ein VPN
# schickt. Tailscale liefert für manche Namen nur IPv6-Adressen; ein Container
# ohne IPv6-Weg nach draußen scheitert dann mit „fetch failed" (ENETUNREACH) –
# und zwar nur bei einzelnen Diensten, was die Suche danach unangenehm macht.
# Bei uns traf es den Microsoft-Login.
#
#   MAPPE_DNS=1.1.1.1
MAPPE_DNS=

# --- Zeitzone --------------------------------------------------------------
TZ=Europe/Berlin
